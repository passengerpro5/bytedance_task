VIDEO_BREAKDOWN_PROVIDER=mock
VIDEO_BREAKDOWN_DATA_DIR=./data
VIDEO_BREAKDOWN_UPLOAD_DIR=./uploads
VIDEO_BREAKDOWN_MAX_UPLOAD_MB=120
SCRIPT_GENERATION_STALE_AFTER_SECONDS=1800
PERSONA_GENERATION_STALE_AFTER_SECONDS=1800
GEMINI_VIDEO_MODEL=gemini-2.5-pro
GEMINI_SCRIPT_MODEL=gemini-3.1-pro-preview
GEMINI_SCRIPT_VOICEOVER_MODEL=gemini-3.1-pro-preview
GEMINI_PERSONA_MODEL=gemini-3.1-pro-preview
GEMINI_DIRECTOR_MODEL=gemini-3.5-flash
GOOGLE_CLOUD_PROJECT_ID=
GOOGLE_CLOUD_LOCATION=global
GOOGLE_VERTEX_AI_API_KEY=
VIDEO_BREAKDOWN_YTDLP_PROXY=
VIDEO_BREAKDOWN_YTDLP_COOKIES_FILE=
VIDEO_FACTORY_ENABLE_HYPERFRAMES_CLI=0
# Supports command arguments; quote paths that contain spaces.
# Example: VIDEO_FACTORY_HYPERFRAMES_CLI="node '/path/to/hyperframes/dist/cli.js'"
VIDEO_FACTORY_HYPERFRAMES_CLI=hyperframes
VIDEO_FACTORY_HYPERFRAMES_CLI_TIMEOUT_SECONDS=120
VIDEO_FACTORY_HYPERFRAMES_HOME_DIR=./data/hyperframes-home
VIDEO_FACTORY_HYPERFRAMES_BROWSER_PATH=
VIDEO_FACTORY_HYPERFRAMES_WORKERS=1
VIDEO_FACTORY_HYPERFRAMES_NO_BROWSER_GPU=1
VIDEO_FACTORY_HYPERFRAMES_USE_DOCKER=0
VIDEO_FACTORY_FFMPEG=ffmpeg
VIDEO_FACTORY_FFPROBE=ffprobe
